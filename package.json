{
  "name": "pr-receipts",
  "version": "0.1.0",
  "description": "Per-PR cost receipts for agent-written code: tokens, list-price dollars and agent time from local Claude Code transcripts, stored in git notes and posted as a sticky PR comment.",
  "keywords": [
    "claude-code",
    "pull-request",
    "github-action",
    "git-notes",
    "llm-cost",
    "token-usage",
    "ai-agents",
    "cli"
  ],
  "homepage": "https://github.com/agnij-dutta/pr-receipts#readme",
  "bugs": {
    "url": "https://github.com/agnij-dutta/pr-receipts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agnij-dutta/pr-receipts.git"
  },
  "license": "MIT",
  "author": "Agnij Dutta (https://github.com/agnij-dutta)",
  "type": "module",
  "bin": {
    "pr-receipts": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/config",
    "config",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && npm run typecheck",
    "fixtures": "node dist/test/fixtures/generate.js",
    "leak-check": "node scripts/leak-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
