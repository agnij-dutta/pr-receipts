# pr-receipts needs no environment variables to run locally. These are the ones
# it reads, for reference. Never put a real token in a committed file.

# Claude Code config dir. Transcripts are read from $CLAUDE_CONFIG_DIR/projects.
# Default: ~/.claude
# CLAUDE_CONFIG_DIR=

# Only for `pr-receipts comment` without --dry-run (the Action sets this itself).
# Needs pull-requests: write on the target repo.
# GITHUB_TOKEN=

# Set by the pre-push hook around its own push of the notes ref. Do not set.
# PR_RECEIPTS_IN_HOOK=
